# ==============================================================================
# AEO Nexus - Environment Variable Template
# Copy this file to .env and configure for local development
# NEVER commit real credentials or production secrets to source control
# ==============================================================================

# General
NODE_ENV=development
APP_NAME="AEO Nexus"
PORT=4000

# Database (PostgreSQL)
POSTGRES_USER=aeonexus
POSTGRES_PASSWORD=aeonexus_dev_secret
POSTGRES_DB=aeo_nexus_dev
POSTGRES_PORT=5432
DATABASE_URL="postgresql://aeonexus:aeonexus_dev_secret@localhost:5432/aeo_nexus_dev?schema=public"

# Cache & Queues (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# Security & Authentication (NestJS API & Web Apps)
JWT_SECRET=dev_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004"

# Application URLs
PUBLIC_WEB_URL=http://localhost:3000
CUSTOMER_WEB_URL=http://localhost:3001
AGENCY_WEB_URL=http://localhost:3002
ADMIN_WEB_URL=http://localhost:3003
SUPERADMIN_WEB_URL=http://localhost:3004
API_URL=http://localhost:4000

# AI Provider Configuration (Placeholders for Phase 2+)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=


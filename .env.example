# ==============================================================================
# AEO Nexus - Environment Variable Template
# Copy this file to .env and configure for local development
# NEVER commit real credentials or production secrets to source control
# ==============================================================================

# General
NODE_ENV=development
APP_NAME="AEO Nexus"
PORT=4000

# Database (Neon Hosted PostgreSQL)
# DATABASE_URL: Neon pooled connection string for runtime application queries (via PgBouncer)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# DIRECT_URL: Neon direct connection string for Prisma migrations (bypasses PgBouncer connection pooling)
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Cache & Queues (Redis - Local Docker or Hosted)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# Security & Authentication (NestJS API & Web Apps)
JWT_SECRET=dev_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004"

# Application URLs (Frontend web applications connect ONLY via API, never direct database)
PUBLIC_WEB_URL=http://localhost:3000
CUSTOMER_WEB_URL=http://localhost:3001
AGENCY_WEB_URL=http://localhost:3002
ADMIN_WEB_URL=http://localhost:3003
SUPERADMIN_WEB_URL=http://localhost:3004
API_URL=http://localhost:4000

# AI Provider Configuration (Placeholders for Phase 2+)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

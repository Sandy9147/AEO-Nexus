{
  "name": "aeo-nexus",
  "version": "0.1.0",
  "private": true,
  "description": "AEO Nexus — Global AI-Powered Business Operating System",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "db:validate": "pnpm --filter @aeo-nexus/api run db:validate",
    "db:generate": "pnpm --filter @aeo-nexus/api run db:generate",
    "db:migrate": "pnpm --filter @aeo-nexus/api run db:migrate",
    "db:deploy": "pnpm --filter @aeo-nexus/api run db:deploy",
    "db:status": "pnpm --filter @aeo-nexus/api run db:status",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}

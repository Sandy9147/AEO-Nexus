// Prisma Schema for AEO Nexus
// Database: Hosted Neon Serverless PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PlatformRole {
  PLATFORM_SUPER_ADMIN
  PLATFORM_ADMIN
  SUPPORT_AGENT
  BILLING_OPERATOR
  // Backwards compatibility
  SUPERADMIN
  PLATFORM_SUPPORT
}

enum WorkspaceRole {
  WORKSPACE_OWNER
  WORKSPACE_ADMIN
  WORKSPACE_MANAGER
  EDITOR
  VIEWER
  // Backwards compatibility
  AGENCY_MANAGER
  WORKSPACE_MEMBER
  WORKSPACE_VIEWER
}

enum AgencyRole {
  AGENCY_OWNER
  AGENCY_ADMIN
  AGENCY_MANAGER
  AGENCY_EDITOR
  AGENCY_CLIENT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum KnowledgeCategory {
  COMPANY
  PRODUCTS
  SERVICES
  FAQS
  POLICIES
  BRAND
  MARKETING
  OPERATIONS
  OTHER
}

enum KnowledgeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  COMMENT_ADDED
  PROJECT_UPDATED
  MEMBER_JOINED
  SYSTEM_ALERT
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  passwordHash    String        @map("password_hash")
  firstName       String        @map("first_name")
  lastName        String        @map("last_name")
  platformRole    PlatformRole? @map("platform_role")
  isActive        Boolean       @default(true) @map("is_active")
  emailVerified   Boolean       @default(false) @map("email_verified")
  emailVerifiedAt DateTime?     @map("email_verified_at")

  memberships             WorkspaceMember[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  createdInvitations      WorkspaceInvitation[]      @relation("InvitedByUser")
  auditLogs               AuditLog[]
  ownedProjects           Project[]                  @relation("ProjectOwner")
  projectMemberships      ProjectMember[]
  createdTasks            Task[]                     @relation("TaskCreator")
  assignedTasks           Task[]                     @relation("TaskAssignee")
  taskComments            TaskComment[]
  projectComments         ProjectComment[]
  createdFolders          AssetFolder[]
  uploadedAssets          Asset[]
  knowledgeDocuments      KnowledgeDocument[]
  knowledgeVersions       KnowledgeDocumentVersion[]
  notifications           Notification[]
  activityEvents          ActivityEvent[]
  aiConversations         AIConversation[]
  aiRuns                  AIRun[]
  aiRequestedApprovals    AIApproval[]               @relation("ApprovalRequester")
  aiReviewedApprovals     AIApproval[]               @relation("ApprovalReviewer")
  aiUsageRecords          AIUsageRecord[]

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model Workspace {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  isActive    Boolean       @default(true) @map("is_active")

  members            WorkspaceMember[]
  invitations        WorkspaceInvitation[]
  auditLogs          AuditLog[]
  businessProfile    BusinessProfile?
  brandProfile       BrandProfile?
  onboardingProgress OnboardingProgress?
  preferences        WorkspacePreference?
  projects           Project[]
  tasks              Task[]
  assetFolders       AssetFolder[]
  assets             Asset[]
  knowledgeDocuments KnowledgeDocument[]
  notifications      Notification[]
  activityEvents     ActivityEvent[]
  aiConversations    AIConversation[]
  aiRuns             AIRun[]
  aiApprovals        AIApproval[]
  aiUsageRecords     AIUsageRecord[]
  aiConfig           AIWorkspaceConfig?

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(WORKSPACE_MEMBER)
  isActive    Boolean       @default(true) @map("is_active")

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  email       String
  role        WorkspaceRole @default(WORKSPACE_MEMBER)
  tokenHash   String        @unique @map("token_hash")
  invitedById String        @map("invited_by_id")
  status      String        @default("PENDING")
  expiresAt   DateTime      @map("expires_at")

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User          @relation("InvitedByUser", fields: [invitedById], references: [id], onDelete: Cascade)

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([email])
  @@index([tokenHash])
  @@map("workspace_invitations")
}

model AuditLog {
  id          String     @id @default(uuid())
  workspaceId String?    @map("workspace_id")
  userId      String?    @map("user_id")
  action      String
  resource    String
  details     Json?
  ipAddress   String?    @map("ip_address")

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([userId])
  @@map("audit_logs")
}

model BusinessProfile {
  id           String    @id @default(uuid())
  workspaceId  String    @unique @map("workspace_id")
  businessName String    @map("business_name")
  website      String?
  industry     String
  country      String
  businessSize String    @map("business_size")
  description  String?

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("business_profiles")
}

model BrandProfile {
  id             String    @id @default(uuid())
  workspaceId    String    @unique @map("workspace_id")
  logoUrl        String?   @map("logo_url")
  primaryColor   String?   @default("#3563F6") @map("primary_color")
  secondaryColor String?   @default("#6554E8") @map("secondary_color")
  brandVoice     String?   @map("brand_voice")
  description    String?

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("brand_profiles")
}

model OnboardingProgress {
  id             String    @id @default(uuid())
  workspaceId    String    @unique @map("workspace_id")
  step           String    @default("business")
  completed      Boolean   @default(false)
  completedSteps Json?     @map("completed_steps")
  goals          Json?
  data           Json?

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("onboarding_progress")
}

model WorkspacePreference {
  id                 String    @id @default(uuid())
  workspaceId        String    @unique @map("workspace_id")
  timezone           String    @default("UTC")
  currency           String    @default("USD")
  emailNotifications Boolean   @default(true) @map("email_notifications")
  weeklyDigest       Boolean   @default(true) @map("weekly_digest")
  marketingUpdates   Boolean   @default(false) @map("marketing_updates")

  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("workspace_preferences")
}

model Project {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?     @map("start_date")
  dueDate     DateTime?     @map("due_date")
  ownerId     String        @map("owner_id")
  isArchived  Boolean       @default(false) @map("is_archived")

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner       User          @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  members     ProjectMember[]
  tasks       Task[]
  comments    ProjectComment[]

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([ownerId])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String   @default("MEMBER") // "LEAD" | "MEMBER" | "VIEWER"

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id          String       @id @default(uuid())
  projectId   String       @map("project_id")
  workspaceId String       @map("workspace_id")
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @map("due_date")
  creatorId   String       @map("creator_id")
  assigneeId  String?      @map("assignee_id")

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     User         @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  comments    TaskComment[]

  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([workspaceId])
  @@index([assigneeId])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  content   String

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([taskId])
  @@index([userId])
  @@map("task_comments")
}

model ProjectComment {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  content   String

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([userId])
  @@map("project_comments")
}

model AssetFolder {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  parentId    String?       @map("parent_id")
  name        String
  createdById String        @map("created_by_id")

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent      AssetFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    AssetFolder[] @relation("FolderHierarchy")
  assets      Asset[]
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([workspaceId, parentId, name])
  @@index([workspaceId])
  @@map("asset_folders")
}

model Asset {
  id              String       @id @default(uuid())
  workspaceId     String       @map("workspace_id")
  folderId        String?      @map("folder_id")
  name            String
  originalName    String       @map("original_name")
  mimeType        String       @map("mime_type")
  sizeBytes       BigInt       @map("size_bytes")
  storageKey      String       @map("storage_key")
  storageProvider String       @default("s3") @map("storage_provider")
  isPublic        Boolean      @default(false) @map("is_public")
  uploadedById    String       @map("uploaded_by_id")
  metadata        Json?

  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder          AssetFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy      User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([folderId])
  @@map("assets")
}

model KnowledgeDocument {
  id          String            @id @default(uuid())
  workspaceId String            @map("workspace_id")
  title       String
  content     String
  category    KnowledgeCategory @default(OTHER)
  status      KnowledgeStatus   @default(DRAFT)
  tags        String[]          @default([])
  sourceUrl   String?           @map("source_url")
  authorId    String            @map("author_id")

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author      User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  versions    KnowledgeDocumentVersion[]

  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([category])
  @@map("knowledge_documents")
}

model KnowledgeDocumentVersion {
  id            String            @id @default(uuid())
  documentId    String            @map("document_id")
  versionNumber Int               @map("version_number")
  title         String
  content       String
  changeSummary String?           @map("change_summary")
  createdById   String            @map("created_by_id")

  document      KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy     User              @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt     DateTime          @default(now()) @map("created_at")

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("knowledge_document_versions")
}

model Notification {
  id          String           @id @default(uuid())
  workspaceId String           @map("workspace_id")
  userId      String           @map("user_id")
  type        NotificationType
  title       String
  message     String
  link        String?
  isRead      Boolean          @default(false) @map("is_read")
  metadata    Json?

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([userId, isRead])
  @@map("notifications")
}

model ActivityEvent {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  userId       String?   @map("user_id")
  action       String
  resourceType String    @map("resource_type")
  resourceId   String    @map("resource_id")
  details      Json?

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([resourceType, resourceId])
  @@map("activity_events")
}

// ============================================================================
// PHASE 5: AI FOUNDATION & AI BUSINESS AGENT
// ============================================================================

enum AiRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  REQUIRES_APPROVAL
  CANCELLED
}

enum AiApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum AiActionType {
  PUBLISH_CONTENT
  SEND_EXTERNAL_MESSAGE
  DELETE_DATA
  MODIFY_SETTINGS
  SPEND_MONEY
  EXTERNAL_INTEGRATION
}

model AIConversation {
  id           String        @id @default(uuid())
  workspaceId  String        @map("workspace_id")
  userId       String        @map("user_id")
  title        String
  model        String        @default("mock-agent-fast")
  provider     String        @default("mock")
  systemPrompt String?       @map("system_prompt")
  isArchived   Boolean       @default(false) @map("is_archived")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     AIMessage[]
  runs         AIRun[]
  approvals    AIApproval[]

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([userId])
  @@map("ai_conversations")
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String         @map("conversation_id")
  role           String         // user, assistant, system, tool
  content        String
  citations      Json?          // Array of { title, documentId, snippet, url }
  toolCalls      Json?          @map("tool_calls") // Array of { id, toolName, args, result, status }
  tokensUsed     Int?           @map("tokens_used")

  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("ai_messages")
}

model AIRun {
  id               String         @id @default(uuid())
  workspaceId      String         @map("workspace_id")
  conversationId   String?        @map("conversation_id")
  userId           String         @map("user_id")
  prompt           String
  status           AiRunStatus    @default(PENDING)
  provider         String
  model            String
  stepCount        Int            @default(0) @map("step_count")
  steps            Json?          // execution trace
  error            String?
  promptTokens     Int            @default(0) @map("prompt_tokens")
  completionTokens Int            @default(0) @map("completion_tokens")
  totalTokens      Int            @default(0) @map("total_tokens")
  costUsd          Decimal        @default(0) @db.Decimal(10, 6) @map("cost_usd")

  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation     AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  approvals        AIApproval[]

  completedAt      DateTime?      @map("completed_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([status])
  @@map("ai_runs")
}

model AIApproval {
  id            String           @id @default(uuid())
  workspaceId   String           @map("workspace_id")
  runId         String?          @map("run_id")
  conversationId String?         @map("conversation_id")
  actionType    AiActionType     @map("action_type")
  title         String
  description   String
  payload       Json
  status        AiApprovalStatus @default(PENDING)
  requestedById String           @map("requested_by_id")
  reviewedById  String?          @map("reviewed_by_id")
  reviewedAt    DateTime?        @map("reviewed_at")
  reviewNotes   String?          @map("review_notes")

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  run           AIRun?           @relation(fields: [runId], references: [id], onDelete: SetNull)
  conversation  AIConversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  requestedBy   User             @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy    User?            @relation("ApprovalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([status])
  @@map("ai_approvals")
}

model AIUsageRecord {
  id              String       @id @default(uuid())
  workspaceId     String       @map("workspace_id")
  userId          String       @map("user_id")
  provider        String
  model           String
  requestId       String       @map("request_id")
  promptTokens    Int          @map("prompt_tokens")
  completionTokens Int         @map("completion_tokens")
  totalTokens     Int          @map("total_tokens")
  estimatedCost   Decimal      @db.Decimal(10, 6) @map("estimated_cost")
  status          String       @default("SUCCESS")

  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime     @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([userId])
  @@index([createdAt])
  @@map("ai_usage_records")
}

model AIWorkspaceConfig {
  id                          String    @id @default(uuid())
  workspaceId                 String    @unique @map("workspace_id")
  defaultProvider             String    @default("mock") @map("default_provider")
  defaultModel                String    @default("mock-agent-fast") @map("default_model")
  monthlyTokenBudget          Int       @default(1000000) @map("monthly_token_budget")
  monthlyCostBudget           Decimal   @default(50.00) @db.Decimal(10, 2) @map("monthly_cost_budget")
  requireApprovalForSensitive Boolean   @default(true) @map("require_approval_for_sensitive")
  customSystemInstructions    String?   @map("custom_system_instructions")

  workspace                   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  @@map("ai_workspace_configs")
}

model AIPromptTemplate {
  id           String    @id @default(uuid())
  workspaceId  String?   @map("workspace_id")
  name         String
  slug         String
  category     String    // STRATEGY, CONTENT, RESEARCH, OPERATIONS
  description  String
  templateText String    @map("template_text")
  variables    String[]  @default([])

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([slug])
  @@map("ai_prompt_templates")
}

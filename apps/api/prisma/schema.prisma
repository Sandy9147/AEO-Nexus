// Prisma Schema for AEO Nexus
// Database: Hosted Neon Serverless PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PlatformRole {
  PLATFORM_SUPER_ADMIN
  PLATFORM_ADMIN
  SUPPORT_AGENT
  BILLING_OPERATOR
  // Backwards compatibility
  SUPERADMIN
  PLATFORM_SUPPORT
}

enum WorkspaceRole {
  WORKSPACE_OWNER
  WORKSPACE_ADMIN
  WORKSPACE_MANAGER
  EDITOR
  VIEWER
  // Backwards compatibility
  AGENCY_MANAGER
  WORKSPACE_MEMBER
  WORKSPACE_VIEWER
}

enum AgencyRole {
  AGENCY_OWNER
  AGENCY_ADMIN
  AGENCY_MANAGER
  AGENCY_EDITOR
  AGENCY_CLIENT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum KnowledgeCategory {
  COMPANY
  PRODUCTS
  SERVICES
  FAQS
  POLICIES
  BRAND
  MARKETING
  OPERATIONS
  OTHER
}

enum KnowledgeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  COMMENT_ADDED
  PROJECT_UPDATED
  MEMBER_JOINED
  SYSTEM_ALERT
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  passwordHash    String        @map("password_hash")
  firstName       String        @map("first_name")
  lastName        String        @map("last_name")
  platformRole    PlatformRole? @map("platform_role")
  isActive        Boolean       @default(true) @map("is_active")
  emailVerified   Boolean       @default(false) @map("email_verified")
  emailVerifiedAt DateTime?     @map("email_verified_at")

  memberships             WorkspaceMember[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  createdInvitations      WorkspaceInvitation[]      @relation("InvitedByUser")
  auditLogs               AuditLog[]
  ownedProjects           Project[]                  @relation("ProjectOwner")
  projectMemberships      ProjectMember[]
  createdTasks            Task[]                     @relation("TaskCreator")
  assignedTasks           Task[]                     @relation("TaskAssignee")
  taskComments            TaskComment[]
  projectComments         ProjectComment[]
  createdFolders          AssetFolder[]
  uploadedAssets          Asset[]
  knowledgeDocuments      KnowledgeDocument[]
  knowledgeVersions       KnowledgeDocumentVersion[]
  notifications           Notification[]
  activityEvents          ActivityEvent[]
  aiConversations         AIConversation[]
  aiRuns                  AIRun[]
  aiRequestedApprovals    AIApproval[]               @relation("ApprovalRequester")
  aiReviewedApprovals     AIApproval[]               @relation("ApprovalReviewer")
  aiUsageRecords          AIUsageRecord[]
  createdResearchProjects ResearchProject[]
  createdStrategicPlans     StrategicPlan[]           @relation("PlanCreator")
  createdPlanVersions       StrategicPlanVersion[]    @relation("PlanVersionCreator")
  assignedGoals             BusinessGoal[]            @relation("GoalOwner")
  recordedGoalProgress      GoalProgressRecord[]      @relation("GoalProgressRecorder")
  ownedInitiatives          StrategicInitiative[]     @relation("InitiativeOwner")
  conductedStrategyReviews  StrategyReview[]          @relation("ReviewConductor")

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model Workspace {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  isActive    Boolean       @default(true) @map("is_active")

  members            WorkspaceMember[]
  invitations        WorkspaceInvitation[]
  auditLogs          AuditLog[]
  businessProfile    BusinessProfile?
  brandProfile       BrandProfile?
  onboardingProgress OnboardingProgress?
  preferences        WorkspacePreference?
  projects           Project[]
  tasks              Task[]
  assetFolders       AssetFolder[]
  assets             Asset[]
  knowledgeDocuments KnowledgeDocument[]
  notifications      Notification[]
  activityEvents     ActivityEvent[]
  aiConversations    AIConversation[]
  aiRuns             AIRun[]
  aiApprovals        AIApproval[]
  aiUsageRecords     AIUsageRecord[]
  aiConfig           AIWorkspaceConfig?
  researchProjects   ResearchProject[]
  competitors        Competitor[]
  audienceProfiles   AudienceProfile[]
  marketOpportunities MarketOpportunity[]
  aeoResearchQuestions AEOResearchQuestion[]
  strategicPlans        StrategicPlan[]
  businessGoals         BusinessGoal[]
  strategicInitiatives  StrategicInitiative[]
  strategicRoadmaps     StrategicRoadmap[]
  roadmapMilestones     RoadmapMilestone[]
  strategyReviews       StrategyReview[]
  planningRecommendations PlanningRecommendation[]

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(WORKSPACE_MEMBER)
  isActive    Boolean       @default(true) @map("is_active")

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  email       String
  role        WorkspaceRole @default(WORKSPACE_MEMBER)
  tokenHash   String        @unique @map("token_hash")
  invitedById String        @map("invited_by_id")
  status      String        @default("PENDING")
  expiresAt   DateTime      @map("expires_at")

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User          @relation("InvitedByUser", fields: [invitedById], references: [id], onDelete: Cascade)

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([email])
  @@index([tokenHash])
  @@map("workspace_invitations")
}

model AuditLog {
  id          String     @id @default(uuid())
  workspaceId String?    @map("workspace_id")
  userId      String?    @map("user_id")
  action      String
  resource    String
  details     Json?
  ipAddress   String?    @map("ip_address")

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([userId])
  @@map("audit_logs")
}

model BusinessProfile {
  id           String    @id @default(uuid())
  workspaceId  String    @unique @map("workspace_id")
  businessName String    @map("business_name")
  website      String?
  industry     String
  country      String
  businessSize String    @map("business_size")
  description  String?

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("business_profiles")
}

model BrandProfile {
  id             String    @id @default(uuid())
  workspaceId    String    @unique @map("workspace_id")
  logoUrl        String?   @map("logo_url")
  primaryColor   String?   @default("#3563F6") @map("primary_color")
  secondaryColor String?   @default("#6554E8") @map("secondary_color")
  brandVoice     String?   @map("brand_voice")
  description    String?

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("brand_profiles")
}

model OnboardingProgress {
  id             String    @id @default(uuid())
  workspaceId    String    @unique @map("workspace_id")
  step           String    @default("business")
  completed      Boolean   @default(false)
  completedSteps Json?     @map("completed_steps")
  goals          Json?
  data           Json?

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("onboarding_progress")
}

model WorkspacePreference {
  id                 String    @id @default(uuid())
  workspaceId        String    @unique @map("workspace_id")
  timezone           String    @default("UTC")
  currency           String    @default("USD")
  emailNotifications Boolean   @default(true) @map("email_notifications")
  weeklyDigest       Boolean   @default(true) @map("weekly_digest")
  marketingUpdates   Boolean   @default(false) @map("marketing_updates")

  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("workspace_preferences")
}

model Project {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?     @map("start_date")
  dueDate     DateTime?     @map("due_date")
  ownerId     String        @map("owner_id")
  isArchived  Boolean       @default(false) @map("is_archived")

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner       User          @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  members     ProjectMember[]
  tasks       Task[]
  comments    ProjectComment[]
  strategicInitiative StrategicInitiative?

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([ownerId])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String   @default("MEMBER") // "LEAD" | "MEMBER" | "VIEWER"

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id          String       @id @default(uuid())
  projectId   String       @map("project_id")
  workspaceId String       @map("workspace_id")
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @map("due_date")
  creatorId   String       @map("creator_id")
  assigneeId  String?      @map("assignee_id")

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     User         @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  comments    TaskComment[]

  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([workspaceId])
  @@index([assigneeId])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  content   String

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([taskId])
  @@index([userId])
  @@map("task_comments")
}

model ProjectComment {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  content   String

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([userId])
  @@map("project_comments")
}

model AssetFolder {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  parentId    String?       @map("parent_id")
  name        String
  createdById String        @map("created_by_id")

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent      AssetFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    AssetFolder[] @relation("FolderHierarchy")
  assets      Asset[]
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([workspaceId, parentId, name])
  @@index([workspaceId])
  @@map("asset_folders")
}

model Asset {
  id              String       @id @default(uuid())
  workspaceId     String       @map("workspace_id")
  folderId        String?      @map("folder_id")
  name            String
  originalName    String       @map("original_name")
  mimeType        String       @map("mime_type")
  sizeBytes       BigInt       @map("size_bytes")
  storageKey      String       @map("storage_key")
  storageProvider String       @default("s3") @map("storage_provider")
  isPublic        Boolean      @default(false) @map("is_public")
  uploadedById    String       @map("uploaded_by_id")
  metadata        Json?

  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder          AssetFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy      User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([folderId])
  @@map("assets")
}

model KnowledgeDocument {
  id          String            @id @default(uuid())
  workspaceId String            @map("workspace_id")
  title       String
  content     String
  category    KnowledgeCategory @default(OTHER)
  status      KnowledgeStatus   @default(DRAFT)
  tags        String[]          @default([])
  sourceUrl   String?           @map("source_url")
  authorId    String            @map("author_id")

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author      User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  versions    KnowledgeDocumentVersion[]

  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([category])
  @@map("knowledge_documents")
}

model KnowledgeDocumentVersion {
  id            String            @id @default(uuid())
  documentId    String            @map("document_id")
  versionNumber Int               @map("version_number")
  title         String
  content       String
  changeSummary String?           @map("change_summary")
  createdById   String            @map("created_by_id")

  document      KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy     User              @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt     DateTime          @default(now()) @map("created_at")

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("knowledge_document_versions")
}

model Notification {
  id          String           @id @default(uuid())
  workspaceId String           @map("workspace_id")
  userId      String           @map("user_id")
  type        NotificationType
  title       String
  message     String
  link        String?
  isRead      Boolean          @default(false) @map("is_read")
  metadata    Json?

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([userId, isRead])
  @@map("notifications")
}

model ActivityEvent {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  userId       String?   @map("user_id")
  action       String
  resourceType String    @map("resource_type")
  resourceId   String    @map("resource_id")
  details      Json?

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([resourceType, resourceId])
  @@map("activity_events")
}

// ============================================================================
// PHASE 5: AI FOUNDATION & AI BUSINESS AGENT
// ============================================================================

enum AiRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  REQUIRES_APPROVAL
  CANCELLED
}

enum AiApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum AiActionType {
  PUBLISH_CONTENT
  SEND_EXTERNAL_MESSAGE
  DELETE_DATA
  MODIFY_SETTINGS
  SPEND_MONEY
  EXTERNAL_INTEGRATION
}

model AIConversation {
  id           String        @id @default(uuid())
  workspaceId  String        @map("workspace_id")
  userId       String        @map("user_id")
  title        String
  model        String        @default("mock-agent-fast")
  provider     String        @default("mock")
  systemPrompt String?       @map("system_prompt")
  isArchived   Boolean       @default(false) @map("is_archived")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     AIMessage[]
  runs         AIRun[]
  approvals    AIApproval[]

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([userId])
  @@map("ai_conversations")
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String         @map("conversation_id")
  role           String         // user, assistant, system, tool
  content        String
  citations      Json?          // Array of { title, documentId, snippet, url }
  toolCalls      Json?          @map("tool_calls") // Array of { id, toolName, args, result, status }
  tokensUsed     Int?           @map("tokens_used")

  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("ai_messages")
}

model AIRun {
  id               String         @id @default(uuid())
  workspaceId      String         @map("workspace_id")
  conversationId   String?        @map("conversation_id")
  userId           String         @map("user_id")
  prompt           String
  status           AiRunStatus    @default(PENDING)
  provider         String
  model            String
  stepCount        Int            @default(0) @map("step_count")
  steps            Json?          // execution trace
  error            String?
  promptTokens     Int            @default(0) @map("prompt_tokens")
  completionTokens Int            @default(0) @map("completion_tokens")
  totalTokens      Int            @default(0) @map("total_tokens")
  costUsd          Decimal        @default(0) @db.Decimal(10, 6) @map("cost_usd")

  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation     AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  approvals        AIApproval[]

  completedAt      DateTime?      @map("completed_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([status])
  @@map("ai_runs")
}

model AIApproval {
  id            String           @id @default(uuid())
  workspaceId   String           @map("workspace_id")
  runId         String?          @map("run_id")
  conversationId String?         @map("conversation_id")
  actionType    AiActionType     @map("action_type")
  title         String
  description   String
  payload       Json
  status        AiApprovalStatus @default(PENDING)
  requestedById String           @map("requested_by_id")
  reviewedById  String?          @map("reviewed_by_id")
  reviewedAt    DateTime?        @map("reviewed_at")
  reviewNotes   String?          @map("review_notes")

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  run           AIRun?           @relation(fields: [runId], references: [id], onDelete: SetNull)
  conversation  AIConversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  requestedBy   User             @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy    User?            @relation("ApprovalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([status])
  @@map("ai_approvals")
}

model AIUsageRecord {
  id              String       @id @default(uuid())
  workspaceId     String       @map("workspace_id")
  userId          String       @map("user_id")
  provider        String
  model           String
  requestId       String       @map("request_id")
  promptTokens    Int          @map("prompt_tokens")
  completionTokens Int         @map("completion_tokens")
  totalTokens     Int          @map("total_tokens")
  estimatedCost   Decimal      @db.Decimal(10, 6) @map("estimated_cost")
  status          String       @default("SUCCESS")

  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime     @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([userId])
  @@index([createdAt])
  @@map("ai_usage_records")
}

model AIWorkspaceConfig {
  id                          String    @id @default(uuid())
  workspaceId                 String    @unique @map("workspace_id")
  defaultProvider             String    @default("mock") @map("default_provider")
  defaultModel                String    @default("mock-agent-fast") @map("default_model")
  monthlyTokenBudget          Int       @default(1000000) @map("monthly_token_budget")
  monthlyCostBudget           Decimal   @default(50.00) @db.Decimal(10, 2) @map("monthly_cost_budget")
  requireApprovalForSensitive Boolean   @default(true) @map("require_approval_for_sensitive")
  customSystemInstructions    String?   @map("custom_system_instructions")

  workspace                   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  @@map("ai_workspace_configs")
}

model AIPromptTemplate {
  id           String    @id @default(uuid())
  workspaceId  String?   @map("workspace_id")
  name         String
  slug         String
  category     String    // STRATEGY, CONTENT, RESEARCH, OPERATIONS
  description  String
  templateText String    @map("template_text")
  variables    String[]  @default([])

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([slug])
  @@map("ai_prompt_templates")
}

// ==============================================================================
// Phase 6A: Discover — AI Business Research & Opportunity Intelligence Models
// ==============================================================================

enum ResearchStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum EvidenceType {
  VERIFIED_SOURCE
  AI_ANALYSIS
  USER_INPUT
  UNVERIFIED_ASSUMPTION
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
  SPECULATIVE
}

enum SourceType {
  WEB_SEARCH
  KNOWLEDGE_VAULT
  INDUSTRY_REPORT
  USER_DOCUMENT
  OFFLINE_KNOWLEDGE
}

model ResearchProject {
  id                  String             @id @default(uuid())
  workspaceId         String             @map("workspace_id")
  createdById         String             @map("created_by_id")
  title               String
  topic               String
  industry            String?
  targetCountry       String?            @map("target_country")
  targetAudience      String?            @map("target_audience")
  businessDescription String?            @map("business_description")
  objective           String             @default("COMPREHENSIVE") // MARKET_OPPORTUNITY, COMPETITOR_ANALYSIS, AUDIENCE_DISCOVERY, TRENDS, AEO_DISCOVERY, COMPREHENSIVE
  status              ResearchStatus     @default(PENDING)
  executiveSummary    String?            @map("executive_summary")
  methodology         String?
  confidenceScore     Float              @default(0.85) @map("confidence_score")
  tokensUsed          Int                @default(0) @map("tokens_used")
  completedAt         DateTime?          @map("completed_at")

  workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy           User               @relation(fields: [createdById], references: [id], onDelete: Cascade)

  runs                ResearchRun[]
  findings            ResearchFinding[]
  sources             ResearchSource[]
  opportunities       MarketOpportunity[]
  competitors         Competitor[]
  audienceProfiles    AudienceProfile[]
  aeoQuestions        AEOResearchQuestion[]
  strategicPlans      StrategicPlan[]

  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([createdById])
  @@index([status])
  @@map("research_projects")
}

model ResearchRun {
  id               String          @id @default(uuid())
  researchId       String          @map("research_id")
  status           ResearchStatus  @default(PENDING)
  provider         String
  model            String
  prompt           String?
  rawResponse      String?         @map("raw_response")
  error            String?
  promptTokens     Int             @default(0) @map("prompt_tokens")
  completionTokens Int             @default(0) @map("completion_tokens")
  totalTokens      Int             @default(0) @map("total_tokens")
  latencyMs        Int             @default(0) @map("latency_ms")

  research         ResearchProject @relation(fields: [researchId], references: [id], onDelete: Cascade)

  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([researchId])
  @@index([status])
  @@map("research_runs")
}

model ResearchFinding {
  id               String          @id @default(uuid())
  researchId       String          @map("research_id")
  category         String          // MARKET_DEMAND, COMPETITIVE_LANDSCAPE, CUSTOMER_PAIN, PRICING, TREND, THREAT, AEO_VISIBILITY
  title            String
  description      String
  evidenceType     EvidenceType    @default(AI_ANALYSIS) @map("evidence_type")
  confidenceLevel  ConfidenceLevel @default(MEDIUM) @map("confidence_level")
  evidenceDetails  String?         @map("evidence_details")
  risks            String?
  recommendations  String?

  research         ResearchProject @relation(fields: [researchId], references: [id], onDelete: Cascade)

  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([researchId])
  @@index([category])
  @@map("research_findings")
}

model ResearchSource {
  id              String          @id @default(uuid())
  researchId      String          @map("research_id")
  title           String
  url             String?
  sourceType      SourceType      @default(KNOWLEDGE_VAULT) @map("source_type")
  publicationDate String?         @map("publication_date")
  accessTimestamp DateTime        @default(now()) @map("access_timestamp")
  snippet         String?
  isVerified      Boolean         @default(false) @map("is_verified")

  research        ResearchProject @relation(fields: [researchId], references: [id], onDelete: Cascade)

  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([researchId])
  @@map("research_sources")
}

model Competitor {
  id                            String          @id @default(uuid())
  workspaceId                   String          @map("workspace_id")
  researchId                    String?         @map("research_id")
  name                          String
  website                       String?
  industry                      String?
  description                   String?
  productsServices              String?         @map("products_services")
  positioning                   String?
  pricingObservations           String?         @map("pricing_observations")
  contentObservations           String?         @map("content_observations")
  strengths                     String[]        @default([])
  weaknesses                    String[]        @default([])
  differentiationOpportunities  String?         @map("differentiation_opportunities")
  evidenceType                  EvidenceType    @default(AI_ANALYSIS) @map("evidence_type")
  isVerified                    Boolean         @default(false) @map("is_verified")

  workspace                     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  research                      ResearchProject? @relation(fields: [researchId], references: [id], onDelete: SetNull)

  createdAt                     DateTime        @default(now()) @map("created_at")
  updatedAt                     DateTime        @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([researchId])
  @@map("competitors")
}

model AudienceProfile {
  id                    String          @id @default(uuid())
  workspaceId           String          @map("workspace_id")
  researchId            String?         @map("research_id")
  segmentName           String          @map("segment_name")
  isAiGenerated         Boolean         @default(true) @map("is_ai_generated")
  idealCustomerProfile  String?         @map("ideal_customer_profile")
  demographics          String?
  painPoints            String[]        @default([]) @map("pain_points")
  needs                 String[]        @default([])
  buyingMotivations     String[]        @default([]) @map("buying_motivations")
  objections            String[]        @default([])
  customerJourney       Json?           @map("customer_journey")

  workspace             Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  research              ResearchProject? @relation(fields: [researchId], references: [id], onDelete: SetNull)

  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([researchId])
  @@map("audience_profiles")
}

model MarketOpportunity {
  id                     String          @id @default(uuid())
  workspaceId            String          @map("workspace_id")
  researchId             String?         @map("research_id")
  title                  String
  description            String
  customerProblem        String          @map("customer_problem")
  marketDemandEvidence   String          @map("market_demand_evidence")
  competitionAnalysis    String?         @map("competition_analysis")
  differentiation        String
  businessFeasibility    String?         @map("business_feasibility")
  potentialBusinessModel String?         @map("potential_business_model")
  assumptions            String[]        @default([])
  risks                  String[]        @default([])
  confidenceLevel        ConfidenceLevel @default(MEDIUM) @map("confidence_level")
  suggestedExperiment    String          @map("suggested_experiment")
  evidenceType           EvidenceType    @default(AI_ANALYSIS) @map("evidence_type")
  status                 String          @default("DISCOVERED") // DISCOVERED, VALIDATING, PURSUED, ARCHIVED

  workspace              Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  research               ResearchProject? @relation(fields: [researchId], references: [id], onDelete: SetNull)
  strategicPlans         StrategicPlan[]
  strategicInitiatives   StrategicInitiative[]

  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([researchId])
  @@index([status])
  @@map("market_opportunities")
}

model AEOResearchQuestion {
  id              String             @id @default(uuid())
  workspaceId     String             @map("workspace_id")
  researchId      String?            @map("research_id")
  topic           String
  queryQuestion   String             @map("query_question")
  targetIndustry  String?            @map("target_industry")
  expectedPersona String?            @map("expected_persona")

  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  research        ResearchProject?   @relation(fields: [researchId], references: [id], onDelete: SetNull)

  results         AEOResearchResult[]

  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([researchId])
  @@map("aeo_research_questions")
}

model AEOResearchResult {
  id                   String              @id @default(uuid())
  questionId           String              @map("question_id")
  provider             String
  model                String
  brandMentioned       Boolean             @default(false) @map("brand_mentioned")
  brandRank            Int?                @map("brand_rank")
  brandSentiment       String?             @map("brand_sentiment")
  competitorsMentioned String[]            @default([]) @map("competitors_mentioned")
  citations            Json?
  rawAnswerExcerpt     String?             @map("raw_answer_excerpt")
  isActualMeasurement Boolean             @default(false) @map("is_actual_measurement")
  researchTimestamp    DateTime            @default(now()) @map("research_timestamp")

  question             AEOResearchQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt            DateTime            @default(now()) @map("created_at")

  @@index([questionId])
  @@map("aeo_research_results")
}

// ============================================================================
// Phase 6B: Plan — AI Business Planning & Strategic Roadmap Models
// ============================================================================

enum PlanStatus {
  DRAFT
  GENERATING
  READY_FOR_REVIEW
  APPROVED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum GoalCategory {
  REVENUE
  CUSTOMER_ACQUISITION
  CUSTOMER_RETENTION
  WEBSITE_TRAFFIC
  BRAND_AWARENESS
  AEO_VISIBILITY
  PRODUCT_LAUNCH
  OPERATIONAL_EFFICIENCY
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_TRACK
  AT_RISK
  BEHIND
  ACHIEVED
  CANCELLED
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InitiativePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InitiativeStatus {
  PROPOSED
  PLANNED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum ReviewPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum ReviewStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

model StrategicPlan {
  id                     String                   @id @default(uuid())
  workspaceId            String                   @map("workspace_id")
  createdById            String                   @map("created_by_id")
  title                  String
  planType               String                   @default("BUSINESS_LAUNCH") @map("plan_type")
  businessStage          String?                  @map("business_stage")
  targetMarket           String?                  @map("target_market")
  targetAudience         String?                  @map("target_audience")
  horizonMonths          Int                      @default(12) @map("horizon_months")
  budgetRange            String?                  @map("budget_range")
  teamSize               String?                  @map("team_size")
  status                 PlanStatus               @default(DRAFT)
  executiveSummary       String?                  @map("executive_summary")
  currentSituation       String?                  @map("current_situation")
  marketPositioning      String?                  @map("market_positioning")
  strategicObjectives    String[]                 @default([]) @map("strategic_objectives")
  requiredResources      String[]                 @default([]) @map("required_resources")
  budgetAssumptions      String[]                 @default([]) @map("budget_assumptions")
  risksAndMitigations    Json?                    @map("risks_and_mitigations")
  dependencies           String[]                 @default([])
  timelineAssumptions    String[]                 @default([]) @map("timeline_assumptions")
  successMetrics         String[]                 @default([]) @map("success_metrics")
  validationRequirements String[]                 @default([]) @map("validation_requirements")
  nextRecommendedActions String[]                 @default([]) @map("next_recommended_actions")
  confidenceScore        Float                    @default(0.85) @map("confidence_score")
  researchId             String?                  @map("research_id")
  opportunityId          String?                  @map("opportunity_id")
  currentVersionNumber   Int                      @default(1) @map("current_version_number")

  workspace              Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy              User                     @relation("PlanCreator", fields: [createdById], references: [id], onDelete: Cascade)
  research               ResearchProject?         @relation(fields: [researchId], references: [id], onDelete: SetNull)
  opportunity            MarketOpportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  versions               StrategicPlanVersion[]
  goals                  BusinessGoal[]
  initiatives            StrategicInitiative[]
  roadmaps               StrategicRoadmap[]
  reviews                StrategyReview[]
  recommendations        PlanningRecommendation[]

  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([createdById])
  @@index([status])
  @@index([researchId])
  @@index([opportunityId])
  @@map("strategic_plans")
}

model StrategicPlanVersion {
  id            String        @id @default(uuid())
  planId        String        @map("plan_id")
  versionNumber Int           @map("version_number")
  title         String
  content       Json
  changeSummary String?       @map("change_summary")
  createdById   String        @map("created_by_id")

  plan          StrategicPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdBy     User          @relation("PlanVersionCreator", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt     DateTime      @default(now()) @map("created_at")

  @@unique([planId, versionNumber])
  @@index([planId])
  @@index([createdById])
  @@map("strategic_plan_versions")
}

model BusinessGoal {
  id                   String               @id @default(uuid())
  workspaceId          String               @map("workspace_id")
  planId               String?              @map("plan_id")
  title                String
  description          String?
  category             GoalCategory         @default(REVENUE)
  targetValue          Float                @map("target_value")
  currentValue         Float                @default(0) @map("current_value")
  unit                 String               @default("USD")
  startDate            DateTime?            @map("start_date")
  targetDate           DateTime?            @map("target_date")
  status               GoalStatus           @default(NOT_STARTED)
  priority             GoalPriority         @default(MEDIUM)
  measurementFrequency String               @default("MONTHLY") @map("measurement_frequency")
  isQualitative        Boolean              @default(false) @map("is_qualitative")
  assignedOwnerId      String?              @map("assigned_owner_id")

  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                 StrategicPlan?       @relation(fields: [planId], references: [id], onDelete: SetNull)
  assignedOwner        User?                @relation("GoalOwner", fields: [assignedOwnerId], references: [id], onDelete: SetNull)

  progressRecords      GoalProgressRecord[]
  initiatives          StrategicInitiative[]

  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([planId])
  @@index([category])
  @@index([status])
  @@map("business_goals")
}

model GoalProgressRecord {
  id                    String       @id @default(uuid())
  goalId                String       @map("goal_id")
  recordedById          String       @map("recorded_by_id")
  previousValue         Float        @map("previous_value")
  newValue              Float        @map("new_value")
  note                  String?
  isExternalMeasurement Boolean      @default(false) @map("is_external_measurement")
  recordedAt            DateTime     @default(now()) @map("recorded_at")

  goal                  BusinessGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  recordedBy            User         @relation("GoalProgressRecorder", fields: [recordedById], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([recordedById])
  @@map("goal_progress_records")
}

model StrategicInitiative {
  id                 String                  @id @default(uuid())
  workspaceId        String                  @map("workspace_id")
  planId             String?                 @map("plan_id")
  goalId             String?                 @map("goal_id")
  opportunityId      String?                 @map("opportunity_id")
  roadmapPhaseId     String?                 @map("roadmap_phase_id")
  name               String
  description        String?
  strategicRationale String?                 @map("strategic_rationale")
  priority           InitiativePriority      @default(MEDIUM)
  status             InitiativeStatus        @default(PLANNED)
  expectedImpact     String                  @default("HIGH") @map("expected_impact")
  estimatedEffort    String                  @default("MEDIUM") @map("estimated_effort")
  estimatedCost      String?                 @map("estimated_cost")
  risks              String[]                @default([])
  recommendedActions String[]                @default([]) @map("recommended_actions")
  evidenceReferences Json?                   @map("evidence_references")
  evidenceType       EvidenceType            @default(AI_ANALYSIS) @map("evidence_type")
  ownerId            String?                 @map("owner_id")
  projectId          String?                 @unique @map("project_id")
  convertedAt        DateTime?               @map("converted_at")

  workspace          Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan               StrategicPlan?          @relation(fields: [planId], references: [id], onDelete: SetNull)
  goal               BusinessGoal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  opportunity        MarketOpportunity?      @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  roadmapPhase       RoadmapPhase?           @relation(fields: [roadmapPhaseId], references: [id], onDelete: SetNull)
  owner              User?                   @relation("InitiativeOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  project            Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)

  outgoingDependencies InitiativeDependency[] @relation("InitiativeOutgoing")
  incomingDependencies InitiativeDependency[] @relation("InitiativeIncoming")

  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([planId])
  @@index([goalId])
  @@index([opportunityId])
  @@index([status])
  @@map("strategic_initiatives")
}

model InitiativeDependency {
  id             String              @id @default(uuid())
  initiativeId   String              @map("initiative_id")
  dependsOnId    String              @map("depends_on_id")
  dependencyType String              @default("BLOCKS") @map("dependency_type")

  initiative     StrategicInitiative @relation("InitiativeOutgoing", fields: [initiativeId], references: [id], onDelete: Cascade)
  dependsOn      StrategicInitiative @relation("InitiativeIncoming", fields: [dependsOnId], references: [id], onDelete: Cascade)

  createdAt      DateTime            @default(now()) @map("created_at")

  @@unique([initiativeId, dependsOnId])
  @@index([initiativeId])
  @@index([dependsOnId])
  @@map("initiative_dependencies")
}

model StrategicRoadmap {
  id          String             @id @default(uuid())
  workspaceId String             @map("workspace_id")
  planId      String?            @map("plan_id")
  title       String
  description String?
  startDate   DateTime?          @map("start_date")
  endDate     DateTime?          @map("end_date")

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan        StrategicPlan?     @relation(fields: [planId], references: [id], onDelete: SetNull)

  phases      RoadmapPhase[]
  milestones  RoadmapMilestone[]

  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([planId])
  @@map("strategic_roadmaps")
}

model RoadmapPhase {
  id          String                @id @default(uuid())
  roadmapId   String                @map("roadmap_id")
  name        String
  description String?
  phaseOrder  Int                   @default(1) @map("phase_order")
  startDate   DateTime?             @map("start_date")
  endDate     DateTime?             @map("end_date")
  status      String                @default("NOT_STARTED")

  roadmap     StrategicRoadmap      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  initiatives StrategicInitiative[]
  milestones  RoadmapMilestone[]

  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  @@index([roadmapId])
  @@map("roadmap_phases")
}

model RoadmapMilestone {
  id              String           @id @default(uuid())
  workspaceId     String           @map("workspace_id")
  roadmapId       String           @map("roadmap_id")
  phaseId         String?          @map("phase_id")
  title           String
  description     String?
  targetDate      DateTime         @map("target_date")
  status          String           @default("PENDING")
  successCriteria String?          @map("success_criteria")
  isOverdue       Boolean          @default(false) @map("is_overdue")

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  roadmap         StrategicRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  phase           RoadmapPhase?    @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([roadmapId])
  @@index([phaseId])
  @@index([status])
  @@map("roadmap_milestones")
}

model StrategyReview {
  id                   String        @id @default(uuid())
  workspaceId          String        @map("workspace_id")
  planId               String        @map("plan_id")
  conductedById        String        @map("conducted_by_id")
  period               ReviewPeriod  @default(MONTHLY)
  status               ReviewStatus  @default(COMPLETED)
  summary              String
  goalsReviewed        Json?         @map("goals_reviewed")
  initiativesReviewed  Json?         @map("initiatives_reviewed")
  blockersIdentified   String[]      @default([]) @map("blockers_identified")
  changedAssumptions   String[]      @default([]) @map("changed_assumptions")
  aiRecommendations    String[]      @default([]) @map("ai_recommendations")
  strategicAdjustments String[]      @default([]) @map("strategic_adjustments")
  reviewDate           DateTime      @default(now()) @map("review_date")

  workspace            Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                 StrategicPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  conductedBy          User          @relation("ReviewConductor", fields: [conductedById], references: [id], onDelete: Cascade)

  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([planId])
  @@index([conductedById])
  @@map("strategy_reviews")
}

model PlanningRecommendation {
  id             String         @id @default(uuid())
  workspaceId    String         @map("workspace_id")
  planId         String?        @map("plan_id")
  title          String
  recommendation String
  category       String         @default("STRATEGY")
  impact         String         @default("HIGH")
  urgency        String         @default("IMMEDIATE")
  evidenceType   EvidenceType   @default(AI_ANALYSIS) @map("evidence_type")
  isActioned     Boolean        @default(false) @map("is_actioned")
  actionedAt     DateTime?      @map("actioned_at")

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan           StrategicPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([planId])
  @@index([isActioned])
  @@map("planning_recommendations")
}

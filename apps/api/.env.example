PORT=4000

# Database (Neon Hosted PostgreSQL)
# DATABASE_URL: Neon pooled connection string for runtime queries (uses connection pooler / pgbouncer)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# DIRECT_URL: Neon direct connection string for Prisma migrations (direct connection, no pgbouncer)
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Cache & Queues (Redis for BullMQ)
REDIS_URL="redis://localhost:6379"

# Security — JWT Authentication
JWT_SECRET=REPLACE_WITH_UNIQUE_JWT_SECRET_MIN_32_CHARS
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004"

# ==============================================================================
# Security — Multi-Factor Authentication (Phase 7A.1, 7A.2 & 7A.3 Operational Hardening)
# ==============================================================================
# IMPORTANT SECURITY NOTICES:
# 1. INDEPENDENCE: MFA keys MUST remain completely independent of JWT_SECRET.
#    Rotating JWT_SECRET must NEVER invalidate or destroy access to encrypted MFA secrets.
# 2. ZERO PRODUCTION TOLERANCE: In PRODUCTION (NODE_ENV=production), both MFA_ENCRYPTION_KEY
#    and MFA_RECOVERY_PEPPER are MANDATORY. The application immediately crashes on startup
#    if either is missing, invalid, or left as a placeholder or development default.
# 3. SECRET MANAGEMENT: Never commit real production secrets to version control.
#    Store these keys in an enterprise secret manager (e.g. AWS Secrets Manager,
#    GCP Secret Manager, or HashiCorp Vault) and inject them at container runtime.

# ------------------------------------------------------------------------------
# 1. MFA_ENCRYPTION_KEY: Primary AES-256-GCM symmetric encryption key for TOTP secrets at rest.
# Format: Exactly 32 bytes represented as 64 hexadecimal characters OR 44 Base64 characters.
# Generate: openssl rand -hex 32
# ------------------------------------------------------------------------------
MFA_ENCRYPTION_KEY="REPLACE_WITH_UNIQUE_64_HEX_CHAR_SECRET"

# ------------------------------------------------------------------------------
# 2. MFA_KEY_VERSION: Active encryption key version identifier (default: "v1").
# All newly enrolled or re-encrypted MFA secrets will be tagged with this version envelope prefix.
# ------------------------------------------------------------------------------
MFA_KEY_VERSION="v1"

# ------------------------------------------------------------------------------
# 3. MFA_ENCRYPTION_KEYS (Key Rotation): JSON map of key versions to 32-byte keys.
# Supports zero-downtime key rotation. Older secrets encrypted under "v1" can still
# be decrypted while all new secrets are written using "v2".
# Format: JSON object mapping version tags ("v1", "v2", ...) to 64-hex/44-base64 keys.
# Example: '{"v1":"REPLACE_WITH_HEX_KEY_V1","v2":"REPLACE_WITH_HEX_KEY_V2"}'
# ------------------------------------------------------------------------------
# MFA_ENCRYPTION_KEYS='{"v1":"REPLACE_WITH_UNIQUE_64_HEX_CHAR_SECRET_V1","v2":"REPLACE_WITH_UNIQUE_64_HEX_CHAR_SECRET_V2"}'

# ------------------------------------------------------------------------------
# 4. MFA_RECOVERY_PEPPER: Server-side secret pepper for HMAC-SHA256 recovery code hashing.
# Format: Independent high-entropy string, minimum 32 characters.
# Generate: openssl rand -hex 32
# ------------------------------------------------------------------------------
MFA_RECOVERY_PEPPER="REPLACE_WITH_UNIQUE_HIGH_ENTROPY_SECRET_MIN_32_CHARS"

# ------------------------------------------------------------------------------
# OPERATIONAL KEY MANAGEMENT & DISASTER RECOVERY PROCEDURES:
#
# A. Secret Generation:
#    $ openssl rand -hex 32  # For MFA_ENCRYPTION_KEY (AES-256)
#    $ openssl rand -hex 32  # For MFA_RECOVERY_PEPPER (HMAC-SHA256)
#
# B. Key Rotation Order:
#    1. Generate new 32-byte key: NEW_KEY=$(openssl rand -hex 32)
#    2. Set MFA_KEY_VERSION="v2"
#    3. Update MFA_ENCRYPTION_KEY to NEW_KEY
#    4. Add both keys to MFA_ENCRYPTION_KEYS JSON map:
#       MFA_ENCRYPTION_KEYS='{"v1":"<old_key>","v2":"<new_key>"}'
#    5. Deploy application. Existing "v1" secrets decrypt seamlessly; new records use "v2".
#    6. Once existing accounts have authenticated or a re-encryption batch job completes,
#       decommission "v1" from MFA_ENCRYPTION_KEYS.
#
# C. Disaster Recovery (Loss of Historical Key):
#    If a historical key is lost, affected users whose secrets were encrypted under that version
#    cannot have their TOTP verified. Users must use their single-use recovery codes to sign in,
#    or an administrator must verify their identity out-of-band and issue an identity reset.
#    Regular automated KMS / Secret Manager backups prevent this failure mode.
# ------------------------------------------------------------------------------

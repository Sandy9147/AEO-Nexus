PORT=4000

# Database (Neon Hosted PostgreSQL)
# DATABASE_URL: Neon pooled connection string for runtime queries (uses connection pooler / pgbouncer)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# DIRECT_URL: Neon direct connection string for Prisma migrations (direct connection, no pgbouncer)
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Cache & Queues (Redis for BullMQ)
REDIS_URL="redis://localhost:6379"

# Security — JWT Authentication
JWT_SECRET=dev_jwt_secret_change_in_production_min_32_chars
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004"

# ==============================================================================
# Security — Multi-Factor Authentication (Phase 7A.1 & 7A.2 Operational Hardening)
# ==============================================================================
# IMPORTANT: These keys MUST remain completely independent of JWT_SECRET.
# Rotating JWT_SECRET must never invalidate or destroy access to encrypted MFA secrets.
# In PRODUCTION (NODE_ENV=production), both variables are MANDATORY and strictly validated.
# Application startup fails with a fatal error if either is missing, short, or invalid.

# 1. MFA_ENCRYPTION_KEY: AES-256-GCM primary symmetric encryption key for TOTP secrets at rest.
# Format: Exactly 32 bytes represented as 64 hexadecimal characters OR 44 Base64 characters.
# Generate: openssl rand -hex 32
MFA_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# 2. MFA_KEY_VERSION: Active encryption key version identifier (defaults to "v1").
MFA_KEY_VERSION="v1"

# 3. MFA_ENCRYPTION_KEYS (Optional for rotation): JSON map of historical key versions.
# Allows transparent decryption of secrets encrypted under older keys during planned key rotation.
# Example: '{"v1":"<old_64_hex_key>","v2":"<new_64_hex_key>"}'
# MFA_ENCRYPTION_KEYS='{"v1":"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"}'

# 4. MFA_RECOVERY_PEPPER: Server-side secret pepper for HMAC-SHA256 hashing of single-use recovery codes.
# Format: High-entropy string, minimum 32 characters.
# Generate: openssl rand -hex 32
MFA_RECOVERY_PEPPER="dev_recovery_pepper_replace_in_production_min_32_chars_long!"
